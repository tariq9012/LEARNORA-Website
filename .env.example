# Learnora environment configuration — PLACEHOLDERS ONLY.
# Copy to .env (never commit .env) and fill in real values locally / in your host's secret manager.

# ============================ Database ====================================
# PostgreSQL connection string used by Prisma at runtime (queries).
# On Neon this is the "pooled" string (hostname contains "-pooler", sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct (unpooled) connection string, used only for migrations (`prisma migrate`).
# On Neon: the string WITHOUT "-pooler". Without a pooler it can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ============================ Authentication ==============================
# Signs/derives session-token hashes and CSRF tokens. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses the development placeholder. Never expose it to the browser.
SESSION_SECRET=

# development | test | production. "production" turns on Secure cookies and
# enforces the production checks below (https APP_URL, resend/gmail email, s3 storage).
NODE_ENV=development

# ============================ Application URL =============================
# Public base URL, no trailing slash. Used for links in emails (password reset).
# Optional in development (defaults to http://localhost:3000); REQUIRED and must be
# https:// in production.
APP_URL=http://localhost:3000

# ============================ Storage =====================================
# local = files on this server's disk (development, or ONE server with a persistent volume)
# s3    = any S3-compatible object store (Cloudflare R2, AWS S3, MinIO, ...)
# Existing files keep being served from wherever they were stored (Asset.storageProvider),
# so switching this only affects NEW uploads.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage/uploads

# Required when STORAGE_PROVIDER=s3. The bucket must stay PRIVATE: all file access
# goes through Learnora's authorized routes.
# Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. us-east-1)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Production refuses local storage unless you set this to true to confirm the
# uploads folder is on a persistent volume (single server only).
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# ============================ Email =======================================
# console = print emails (incl. reset links) to the server log — development only
# gmail   = Gmail SMTP with an app password (low volume; see limits below)
# resend  = send through Resend (recommended for real traffic)
# Production accepts gmail or resend. Only ONE provider is used: whatever EMAIL_PROVIDER says.
EMAIL_PROVIDER=console

# --- Gmail SMTP (EMAIL_PROVIDER=gmail) ---
# GMAIL_PASS must be a 16-letter Gmail "app password" (Google Account -> Security ->
# 2-Step Verification -> App passwords) — NEVER your real Gmail password. Requires 2FA.
# Spaces are ignored, so you can paste it as Google shows it (abcd efgh ijkl mnop).
# Gmail always sends as GMAIL_USER (EMAIL_FROM cannot change the sender address) and limits
# how many emails you can send per day (about 500 for a normal account).
GMAIL_USER=
GMAIL_PASS=

# --- Resend (EMAIL_PROVIDER=resend) ---
# EMAIL_FROM must use a domain verified in Resend, e.g. "Learnora <no-reply@your-domain.example>".
# With gmail, EMAIL_FROM is optional (default: "Learnora <GMAIL_USER>").
RESEND_API_KEY=
EMAIL_FROM=

# ============================ Payments & finance (Phases 9-10) ============
# Only "simulated" exists: no real money moves. A real provider + webhook
# verification is required before any real-money use.
PAYMENT_PROVIDER=simulated
# Instructor share of each paid enrolment, percent (0-100, max 2 decimals).
INSTRUCTOR_REVENUE_SHARE_PERCENT=70
# Smallest balance an instructor can request as a payout.
MINIMUM_PAYOUT_AMOUNT=50

# ---- Phase 19: scheduled jobs and live updates -----------------------------------
# Authorizes the daily upload-cleanup cron endpoint (Vercel Cron sends it as a Bearer
# token). 32+ random characters, server-only, different from SESSION_SECRET.
# Unset = the endpoint answers 503 and does nothing.
CRON_SECRET=
# Live-update stream (/api/events): auto (default; off on Vercel, on elsewhere) | on | off.
# Polling keeps working either way.
REALTIME_SSE=auto

# ---- Phase 20: Content-Security-Policy mode ---------------------------------------
# report-only (default): the browser logs violations in its console, nothing is blocked.
# enforce: blocks violations. off: sends no CSP. Promote to enforce after a clean browser
# check (see DEPLOYMENT.md section 12).
CSP_MODE=report-only
