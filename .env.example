# PostgreSQL connection string used by Prisma at runtime (queries).
#
# If you're on Neon, this is the "pooled" connection string from your
# Neon dashboard (hostname contains "-pooler", includes sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct (unpooled) connection string, used only for migrations
# (`prisma migrate`). On Neon this is the connection string WITHOUT
# "-pooler" in the hostname. If your provider has no pooler, this can be
# the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
