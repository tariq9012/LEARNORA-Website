# Logs (anchored: an unanchored `logs` would also ignore any src/**/logs folder)
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
/dist
/dist-ssr
/.output
.vinxi
.tanstack/**
/.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Generated Prisma client (regenerate with `npm run db:generate`)
src/generated/

# Local uploaded media (development storage). ANCHORED to the repo root: the old
# unanchored `storage/` also matched src/server/storage/ and silently ignored new
# files there (that is how s3-storage-provider.ts went missing from Vercel).
/storage/

# Vercel CLI link + local build output (never commit)
.vercel
