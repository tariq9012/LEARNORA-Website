// Learnora — production database schema
//
// This is the backend/database foundation for the LMS (Phase 2). It is not
// yet wired up to the frontend, which still runs on src/data/mock.ts until
// a later migration phase.
//
// Prisma ORM 7 moved connection configuration out of this file and into
// prisma.config.ts at the project root (see that file for DATABASE_URL /
// DIRECT_URL wiring). Run `npm run db:generate` after changing this file,
// and `npm run db:migrate` to create/apply a migration.

generator client {
  // Rust-free client + engine: no native/Rust binary to download at
  // generate-time, smaller bundle, and requires a driver adapter (see
  // src/server/db/client.ts) instead of a `url` below.
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum InstructorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Payout lifecycle (Phase 10). Only PENDING -> PAID | REJECTED is driven by
// the app today (an admin decision); PROCESSING/FAILED already existed and
// are kept for a future real payout provider. FAILED = a transfer attempt
// failed; REJECTED = an admin declined the request. Both release the
// reserved earnings, and PENDING/PROCESSING both count as "locked".
enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
}

// Instructor-earning lifecycle (Phase 10). An earning is AVAILABLE the
// moment its paid purchase commits (no hold period in the simulated phase),
// RESERVED while it is locked into a PENDING payout, PAID once that payout
// is paid, and REVERSED when the purchase is refunded.
enum EarningStatus {
  AVAILABLE
  RESERVED
  PAID
  REVERSED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

// Phase 11 mapping of business events onto types (equivalent values reused,
// only genuinely missing ones added):
//   course enrolled                      -> ENROLLMENT
//   payment success                      -> PAYMENT   (failure is not notified: the student sees it on screen)
//   refund completed / earning reversed  -> REFUND
//   payout requested / paid / rejected   -> PAYOUT    (distinguished by title + eventKey)
//   course approved / rejected           -> COURSE_APPROVED / COURSE_REJECTED
//   course completed / certificate ready -> COURSE_COMPLETED / CERTIFICATE_READY
//   new chat message                     -> NEW_MESSAGE
enum NotificationType {
  ENROLLMENT
  COURSE_APPROVED
  COURSE_REJECTED
  NEW_REVIEW
  NEW_MESSAGE
  PAYOUT
  SYSTEM
  ANNOUNCEMENT
  PAYMENT
  REFUND
  COURSE_COMPLETED
  CERTIFICATE_READY
}

enum ReportTargetType {
  COURSE
  USER
  REVIEW
  MESSAGE
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISLEADING
  OTHER
}

// The moderation action actually taken when a report was resolved (null
// while OPEN/IN_REVIEW, and null for a DISMISSED report — dismissing takes
// no action on the content).
enum ReportAction {
  REVIEW_HIDDEN
  REVIEW_RESTORED
  MESSAGE_REMOVED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum AssetPurpose {
  COURSE_THUMBNAIL
  COURSE_PREVIEW
  LESSON_VIDEO
  LESSON_RESOURCE
  AVATAR
}

enum StorageProviderKind {
  LOCAL
  S3
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  // Legacy URL field, same pattern as Course.thumbnail: pre-Phase-13 rows may
  // still have a plain string here. New avatars use avatarAssetId below; DTOs
  // fall back to this only when no Asset is set. See src/server/services/profile-service.ts.
  avatar        String?
  avatarAssetId String?    @unique
  avatarAsset   Asset?     @relation("UserAvatarAsset", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  role          UserRole   @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  studentProfile    StudentProfile?
  instructorProfile InstructorProfile?

  coursesInstructed      Course[]                  @relation("InstructorCourses")
  coursesReviewed        Course[]                  @relation("CourseReviewedBy")
  instructorProfilesReviewed InstructorProfile[]    @relation("InstructorProfileReviewedBy")
  enrollments            Enrollment[]
  reviews                Review[]
  wishlist               Wishlist[]
  orders                 Order[]
  certificates           Certificate[]
  notifications          Notification[]
  conversations          ConversationParticipant[]
  sentMessages           Message[]                 @relation("MessageSender")
  studentConversations   Conversation[]            @relation("ConversationStudent")
  earnings               InstructorEarning[]
  payouts                Payout[]                  @relation("InstructorPayouts")
  payoutsProcessed       Payout[]                  @relation("PayoutsProcessed")
  reportsFiled           Report[]                  @relation("ReportsFiled")
  reportsResolved        Report[]                  @relation("ReportsResolved")
  refundsRequested       Refund[]                  @relation("RefundsRequested")
  refundsProcessed       Refund[]                  @relation("RefundsProcessed")
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  assets                 Asset[]                   @relation("AssetOwner")
  notificationPreference NotificationPreference?

  @@index([role])
  @@index([status])
  @@map("users")
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  headline          String?
  interests         String[]
  learningGoals     String?
  preferredLanguage String?
  website           String?
  location          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("student_profiles")
}

model InstructorProfile {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String?
  expertise       String[]
  yearsExperience Int?
  website         String?
  socialLinks     Json?
  approvalStatus  InstructorApprovalStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  // Mirrors Course.reviewedAt/reviewedById exactly — set on every admin
  // decision (approve OR reject), so "who decided and when" is recorded
  // even though approvedAt only means something on the approve path.
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                    @relation("InstructorProfileReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  // Denormalized aggregates, recomputed by the application from Review /
  // Enrollment rather than maintained by hand.
  averageRating   Decimal?                 @db.Decimal(3, 2)
  totalStudents   Int                      @default(0)
  totalCourses    Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([approvalStatus])
  @@map("instructor_profiles")
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

model Category {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  icon        String?
  image       String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  courses Course[]

  @@index([status])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Media assets (Phase 7)
// ---------------------------------------------------------------------------

// Metadata/reference only — the binary itself lives in whatever
// `storageProvider` + `storageKey` point at (local disk in development;
// object storage in production). Never store file bytes in Postgres.
model Asset {
  id               String              @id @default(cuid())
  ownerId          String
  owner            User                @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  storageProvider  StorageProviderKind @default(LOCAL)
  // Server-generated, e.g. "courses/<id>/thumbnail/<uuid>.jpg" — never a
  // client-supplied path. See src/server/media/media-keys.ts.
  storageKey       String              @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  purpose          AssetPurpose
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  courseThumbnailOf Course?          @relation("CourseThumbnailAsset")
  coursePreviewOf   Course?          @relation("CoursePreviewAsset")
  lessonVideoOf     Lesson?          @relation("LessonVideoAsset")
  lessonResources   LessonResource[]
  avatarOf          User?            @relation("UserAvatarAsset")

  @@index([ownerId])
  @@index([purpose])
  @@map("assets")
}

// Phase 18: one row per direct-to-R2 upload the server has authorized.
// The server records WHAT it signed (key, size, type, owner, target) BEFORE the
// browser uploads, so finalize can verify the object against this row instead
// of trusting anything the browser says. Single-use: `finalizedAt`/`assetId`
// are set exactly once, inside the same transaction that creates the Asset.
// Deliberately NOT foreign-keyed to users/courses/lessons: a leftover row must
// never block deleting those, and authorization is re-checked at finalize.
model UploadIntent {
  id               String       @id @default(cuid())
  userId           String
  purpose          AssetPurpose
  courseId         String?
  lessonId         String?
  // Server-generated (media-keys.ts); unique so two intents can never share an object.
  storageKey       String       @unique
  originalFilename String
  mimeType         String
  expectedSize     Int
  resourceTitle    String?
  // Finalize must happen before this. The presigned URL itself expires much sooner.
  expiresAt        DateTime
  finalizedAt      DateTime?
  assetId          String?      @unique
  createdAt        DateTime     @default(now())

  @@index([userId])
  @@index([finalizedAt, expiresAt])
  @@map("upload_intents")
}

// Multiple resources (PDF/ZIP/DOC/etc.) can be attached to one lesson.
model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assetId   String   @unique
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_resources")
}

// ---------------------------------------------------------------------------
// Courses
// ---------------------------------------------------------------------------

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  subtitle         String?
  description      String?
  // Legacy URL fields from the Phase 6 "paste a URL" flow. New uploads use
  // thumbnailAsset/previewAsset below; DTOs fall back to these only when no
  // Asset is set yet, so old seeded/published courses keep working. See
  // src/server/services/media-service.ts.
  thumbnail        String?
  previewVideo     String?
  thumbnailAssetId String?      @unique
  thumbnailAsset   Asset?       @relation("CourseThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  previewAssetId   String?      @unique
  previewAsset     Asset?       @relation("CoursePreviewAsset", fields: [previewAssetId], references: [id], onDelete: SetNull)
  instructorId     String
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  level            CourseLevel  @default(ALL_LEVELS)
  language         String       @default("English")
  price            Decimal      @db.Decimal(10, 2)
  discountPrice    Decimal?     @db.Decimal(10, 2)
  status           CourseStatus @default(DRAFT)
  rejectionReason  String?
  // Course review workflow — set when the instructor submits, and when an
  // admin decides. reviewedById is a relation (not a plain name) so we
  // always have a real, safe-to-join identity for "who reviewed this".
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?        @relation("CourseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  featured         Boolean      @default(false)
  requirements     String[]
  learningOutcomes String[]
  targetAudience   String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  publishedAt      DateTime?

  sections      CourseSection[]
  enrollments   Enrollment[]
  reviews       Review[]
  conversations Conversation[]
  wishlistedBy  Wishlist[]
  orderItems    OrderItem[]
  certificates  Certificate[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  // Added for Phase 14's instructor course-performance / admin course
  // filters (instructor's own courses by status).
  @@index([instructorId, status])
  @@map("courses")
}

model CourseSection {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int

  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id          String        @id @default(cuid())
  sectionId   String
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        LessonType    @default(VIDEO)
  // Legacy URL field from the Phase 6 "paste a URL" flow — see the note on
  // Course.thumbnail above. New VIDEO lessons use videoAsset instead.
  videoUrl    String?
  content     String?
  // Duration in seconds.
  duration    Int?
  position    Int
  isPreview   Boolean       @default(false)

  videoAssetId String?          @unique
  videoAsset   Asset?           @relation("LessonVideoAsset", fields: [videoAssetId], references: [id], onDelete: SetNull)
  resources    LessonResource[]
  progress     LessonProgress[]

  @@unique([sectionId, position])
  @@index([sectionId])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Enrollments & progress
// ---------------------------------------------------------------------------

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  // Updated whenever the student opens the learning route or a lesson —
  // drives a real "continue learning" ordering instead of insertion order.
  lastAccessedAt DateTime?

  lessonProgress LessonProgress[]

  // A student can only enroll in a given course once.
  @@unique([userId, courseId])
  // [courseId, status] serves plain courseId lookups too (leftmost
  // prefix), so this replaces the old bare @@index([courseId]) rather
  // than sitting alongside it. Added for Phase 14's admin
  // enrollments/instructor students filters.
  @@index([courseId, status])
  @@index([userId, status])
  @@map("enrollments")
}

model LessonProgress {
  id              String     @id @default(cuid())
  enrollmentId    String
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed       Boolean    @default(false)
  // 0-100, maintained by the application.
  progressPercent Int        @default(0)
  watchedSeconds  Int        @default(0)
  completedAt     DateTime?
  updatedAt       DateTime   @updatedAt

  // One progress record per lesson per enrollment.
  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// Reviews & wishlist
// ---------------------------------------------------------------------------

model Review {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // 1-5, validated at the application layer.
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Phase 12 moderation: a hidden review is kept for audit but excluded from
  // every public listing and rating aggregation. Null = visible (the default).
  hiddenAt  DateTime?

  // One review per student per course.
  @@unique([userId, courseId])
  @@index([courseId])
  @@index([courseId, hiddenAt])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

model Order {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Safe public reference (e.g. LRN-ORD-XXXXXXXXXX) — never the internal
  // cuid — shown to the student and used on the success page URL.
  orderNumber String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  earning InstructorEarning?

  // A course can only appear once per order.
  @@unique([orderId, courseId])
  @@index([courseId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  provider          String
  externalReference String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // At most one refund per payment (Phase 10: full refunds only). The
  // unique Refund.paymentId is the DB-level guard against a double refund.
  refund Refund?

  @@index([orderId])
  @@index([status])
  // Added for Phase 14's admin dashboard revenue-by-month grouping and
  // admin payments date-range filtering.
  @@index([status, createdAt])
  @@map("payments")
}

model Refund {
  id                String       @id @default(cuid())
  // Unique: one refund per payment. Phase 10 only issues FULL refunds, so a
  // second refund row for the same payment is always a bug — the database
  // rejects it even if two admin requests race past the application checks.
  paymentId         String       @unique
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Safe public reference (LRN-REF-XXXXXXXXXX), shown in the admin UI.
  reference         String       @unique
  // The payment provider's own refund id (simulated: SIM-RFD-...). Internal.
  externalReference String?      @unique
  amount            Decimal      @db.Decimal(10, 2)
  reason            String?
  status            RefundStatus @default(REQUESTED)
  requestedById     String
  requestedBy       User         @relation("RefundsRequested", fields: [requestedById], references: [id])
  processedById     String?
  processedBy       User?        @relation("RefundsProcessed", fields: [processedById], references: [id])
  createdAt         DateTime     @default(now())
  processedAt       DateTime?

  // The instructor earning reversed by this refund (if the order had one).
  earning InstructorEarning?

  @@index([status])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Instructor earnings & payouts
// ---------------------------------------------------------------------------

model InstructorEarning {
  id             String        @id @default(cuid())
  instructorId   String
  instructor     User          @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  orderItemId    String        @unique
  orderItem      OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  grossAmount    Decimal       @db.Decimal(10, 2)
  // The PLATFORM's share of the sale as a rate, e.g. 0.3000 = platform keeps
  // 30% / instructor keeps 70%. Snapshotted per earning so changing the
  // configured revenue share later never rewrites history (see
  // src/server/config/finance-policy.ts). The platform amount is derivable
  // as grossAmount - netAmount.
  commissionRate Decimal       @db.Decimal(5, 4)
  netAmount      Decimal       @db.Decimal(10, 2)
  // Phase 10 lifecycle. Invariants (also enforced by CHECK constraints in
  // the earnings_refunds_payouts migration):
  //   payoutId IS NOT NULL  <=>  status IN (RESERVED, PAID)
  //   refundId IS NOT NULL  <=>  status = REVERSED
  status         EarningStatus @default(AVAILABLE)
  payoutId       String?
  payout         Payout?       @relation(fields: [payoutId], references: [id])
  refundId       String?       @unique
  refund         Refund?       @relation(fields: [refundId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())

  @@index([instructorId])
  @@index([instructorId, status])
  @@index([payoutId])
  @@map("instructor_earnings")
}

model Payout {
  id              String       @id @default(cuid())
  instructorId    String
  instructor      User         @relation("InstructorPayouts", fields: [instructorId], references: [id], onDelete: Cascade)
  // Always equals the sum of the netAmount of the earnings reserved by this
  // payout (server-derived — never client-supplied).
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("USD")
  status          PayoutStatus @default(PENDING)
  // Phase 10 payouts are SIMULATED: method is always "SIMULATED" and no
  // bank/card details are ever collected or stored.
  method          String?
  // Safe public reference (LRN-PAY-XXXXXXXXXX).
  reference       String?      @unique
  requestedAt     DateTime     @default(now())
  // When an admin decided the request (paid OR rejected). For a PAID payout
  // this is the "paid at" date.
  processedAt     DateTime?
  processedById   String?
  processedBy     User?        @relation("PayoutsProcessed", fields: [processedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  earnings InstructorEarning[]

  @@index([instructorId])
  @@index([status])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 11: a conversation is a course-related thread between ONE student
  // and that course's instructor. UNIQUE(courseId, studentId) is the
  // database-level guard against duplicate threads under concurrent
  // "Message instructor" clicks. Both are nullable only so pre-Phase-11 rows
  // (none are created by the app) remain valid.
  courseId      String?
  course        Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studentId     String?
  student       User?     @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  // Denormalised time of the newest message; drives inbox ordering without
  // scanning messages. NULL until the first message is sent.
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([courseId, studentId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  // Unused in Phase 11: read state is tracked per participant
  // (ConversationParticipant.lastReadAt) because conversations are 1-to-1.
  readAt          DateTime?
  // Client-generated idempotency key: a retried "send" carrying the same
  // key returns the original message instead of creating a duplicate.
  clientMessageId String?
  createdAt       DateTime     @default(now())
  // Phase 12 moderation tombstone: the row and its original `content` are
  // NEVER deleted (that's the evidence in a report's snapshot); when set,
  // the messaging UI shows "Message removed by moderation." instead of the
  // real text to every participant (not just the reporter).
  removedAt       DateTime?

  @@unique([senderId, clientMessageId])
  // Supports cursor pagination through a conversation's history.
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  // Safe INTERNAL app path only (e.g. "/student/purchases"); validated by
  // src/lib/safe-path.ts on write and again on render. Never an external URL.
  link      String?
  // Deduplication key for events that can be retried (payment, refund,
  // payout, certificate, completion, moderation, message). Unique PER USER,
  // so one event can still notify several people (student AND instructor).
  // Never derived from the title/message text. NULL = not deduplicated.
  eventKey  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, eventKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// Phase 12 — per-user, per-category in-app notification preferences. One row
// per user, created lazily with all-enabled defaults on first read/write.
// Categories intentionally correspond to notification-events.ts, not to
// individual NotificationType values, so payoutRequested/Paid/Rejected (all
// stored as PAYOUT) share the single `payouts` toggle. SYSTEM and
// ANNOUNCEMENT notifications are NOT gated by any of these — see
// notification-service.ts's "always-on" categories — so there is no field
// for them here.
model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseUpdates Boolean  @default(true)
  payments      Boolean  @default(true)
  refunds       Boolean  @default(true)
  payouts       Boolean  @default(true)
  messages      Boolean  @default(true)
  certificates  Boolean  @default(true)
  moderation    Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Certificates
// ---------------------------------------------------------------------------

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateCode String   @unique
  // Snapshotted at issuance so a certificate never silently changes if the
  // student later renames their profile or the instructor edits the course
  // title — a completion credential should reflect what was true when it
  // was earned, not the current state of unrelated records.
  learnerName     String
  courseTitle     String
  issuedAt        DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Admin / moderation
// ---------------------------------------------------------------------------

model Report {
  id              String           @id @default(cuid())
  reporterId      String
  reporter        User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType
  targetId        String
  reason          ReportReason
  details         String?
  // Immutable evidence captured AT REPORT TIME, so a later edit/deletion of
  // the underlying content can't erase moderation context. Only populated
  // for MESSAGE reports (see ReportedMessageSnapshot in
  // src/server/dto/moderation.ts for its shape) — a REVIEW report doesn't
  // need one because the review itself is preserved (hidden, not deleted).
  contentSnapshot Json?
  status          ReportStatus     @default(OPEN)
  // The action actually taken when resolved (null for DISMISSED or while open).
  action          ReportAction?
  // Admin-only, bounded, NEVER shown to the reporter or the reported user.
  adminNote       String?
  resolvedById    String?
  resolvedBy      User?            @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([status, createdAt])
  @@index([targetType, status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Authentication (Phase 3)
// ---------------------------------------------------------------------------

// Opaque, database-backed session. The cookie only ever holds a random
// token; `tokenHash` (an HMAC of that token, keyed by SESSION_SECRET) is
// what's stored here, so a leaked database row can't be replayed as a
// cookie value. See src/server/auth/session.ts.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Same opaque-token pattern as Session: only a hash is stored, the raw
// token is what goes in the (future) reset email link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
